{
  "name": "drum-vrm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "wasm-pack build crates/drum-engine --target web --out-dir ../../src/wasm --out-name drum_engine --release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "npm run typecheck && vite build",
    "build": "npm run build:wasm && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "lucide": "1.61.0",
    "mediabunny": "1.62.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
